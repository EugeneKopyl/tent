# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/tent-db

# MongoDB Proxy Configuration (for local development only)
# Uncomment and configure the proxy URL below if you need to use a proxy for MongoDB connections
# This will only be used when NODE_ENV=development
# MONGODB_PROXY=socks5://127.0.0.1:1080
# MONGODB_PROXY=socks5://username:password@127.0.0.1:1080
# MONGODB_PROXY=http://127.0.0.1:8080

# Admin Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# JWT Secret (generate a secure random string for production)
JWT_SECRET=your-super-secret-jwt-key-here

# Node Environment
NODE_ENV=development
